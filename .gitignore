# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
dist/
build/
*.egg-info/
pip-wheel-metadata/

# Virtual environment
.venv/
env/
venv/

# Poetry-specific
poetry.lock

# PyCharm
.idea/
*.iml
*.ipr
*.iws

# VSCode
.vscode/
*.code-workspace

# Logs and temporary files
logs/
*.log
*.tmp
*.swp
*.swo

# Python test-related
.coverage
.tox/
.nox/
pytest_cache/

# Frontend dependencies
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.turbo/
frontend/.cache/
frontend/package-lock.json

# TypeScript build artifacts
frontend/*.tsbuildinfo

# Editor backup and swap files
*.bak
*.swp
*.swo
.DS_Store

# System-specific files
Thumbs.db
ehthumbs.db
desktop.ini

# Ignore compiled binaries
*.exe
*.dll
*.so
*.dylib
*.out
*.o

# Ignore specific files that may contain sensitive data
.env
.env.local
.env.development
.env.production
secrets.toml

assets/
local/